generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model EFMigrationsHistory {
  MigrationId    String @id(map: "PK___EFMigrationsHistory") @db.NVarChar(150)
  ProductVersion String @db.NVarChar(32)

  @@map("__EFMigrationsHistory")
}

model InventoryItems {
  Id                Int              @id(map: "PK_InventoryItems") @default(autoincrement())
  Name              String           @db.NVarChar(150)
  Category          String           @db.NVarChar(50)
  SerialNumber      String?          @db.NVarChar(100)
  Status            Int
  StorageLocationId Int
  LabId             Int?
  Labs              Labs?            @relation(fields: [LabId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_InventoryItems_Labs_LabId")
  StorageLocations  StorageLocations @relation(fields: [StorageLocationId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_InventoryItems_StorageLocations_StorageLocationId")
  Movements         Movements[]

  @@index([LabId], map: "IX_InventoryItems_LabId")
  @@index([StorageLocationId], map: "IX_InventoryItems_StorageLocationId")
}

model Labs {
  Id               Int                @id(map: "PK_Labs") @default(autoincrement())
  Name             String             @db.NVarChar(100)
  TeacherId        Int?
  InventoryItems   InventoryItems[]
  Users            Users?             @relation(fields: [TeacherId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Labs_Users_TeacherId")
  StorageLocations StorageLocations[]

  @@index([TeacherId], map: "IX_Labs_TeacherId")
}

model Movements {
  Id                                                                 Int               @id(map: "PK_Movements") @default(autoincrement())
  Date                                                               DateTime
  Type                                                               Int
  InventoryItemId                                                    Int
  FromStorageLocationId                                              Int?
  ToStorageLocationId                                                Int?
  PerformedByUserId                                                  Int
  PerformedById                                                      Int
  InventoryItems                                                     InventoryItems    @relation(fields: [InventoryItemId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Movements_InventoryItems_InventoryItemId")
  StorageLocations_Movements_FromStorageLocationIdToStorageLocations StorageLocations? @relation("Movements_FromStorageLocationIdToStorageLocations", fields: [FromStorageLocationId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Movements_StorageLocations_FromStorageLocationId")
  StorageLocations_Movements_ToStorageLocationIdToStorageLocations   StorageLocations? @relation("Movements_ToStorageLocationIdToStorageLocations", fields: [ToStorageLocationId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Movements_StorageLocations_ToStorageLocationId")
  Users                                                              Users             @relation(fields: [PerformedById], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Movements_Users_PerformedById")

  @@index([FromStorageLocationId], map: "IX_Movements_FromStorageLocationId")
  @@index([InventoryItemId], map: "IX_Movements_InventoryItemId")
  @@index([PerformedById], map: "IX_Movements_PerformedById")
  @@index([ToStorageLocationId], map: "IX_Movements_ToStorageLocationId")
}

model Roles {
  Id    Int     @id(map: "PK_Roles") @default(autoincrement())
  Name  String  @db.NVarChar(50)
  Users Users[]
}

model StorageLocations {
  Id                                                          Int              @id(map: "PK_StorageLocations") @default(autoincrement())
  Name                                                        String           @db.NVarChar(100)
  Description                                                 String           @db.NVarChar(200)
  LabId                                                       Int?
  InventoryItems                                              InventoryItems[]
  Movements_Movements_FromStorageLocationIdToStorageLocations Movements[]      @relation("Movements_FromStorageLocationIdToStorageLocations")
  Movements_Movements_ToStorageLocationIdToStorageLocations   Movements[]      @relation("Movements_ToStorageLocationIdToStorageLocations")
  Labs                                                        Labs?            @relation(fields: [LabId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_StorageLocations_Labs_LabId")
}

model Users {
  Id        Int         @id(map: "PK_Users") @default(autoincrement())
  Username  String      @db.NVarChar(100)
  RoleId    Int
  Password  String      @default("N'", map: "DF__Users__Password__5DCAEF64") @db.NVarChar(100)
  Labs      Labs[]
  Movements Movements[]
  Roles     Roles       @relation(fields: [RoleId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Users_Roles_RoleId")

  @@index([RoleId], map: "IX_Users_RoleId")
}
